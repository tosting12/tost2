    <!-- Applikationslogik & Three.js 3D-motor -->
    <script>
        // --- Konstanter & Materialdata ---
        const BUILD_VOLUME_MM = 250; // 250 x 250 x 250 mm kub
        const BASE_START_FEE = 40.0; // Startavgift i SEK inkl. moms

        const MATERIALS = {
            PLA:  { name: 'PLA Standard',       pricePerCm3: 1.50, density: 1.24 },
            PETG: { name: 'PETG Slagtålig',     pricePerCm3: 2.10, density: 1.27 },
            ASA:  { name: 'ASA UV-beständig',   pricePerCm3: 2.60, density: 1.07 },
            PC:   { name: 'PC Polykarbonat',    pricePerCm3: 3.80, density: 1.20 }
        };

        // --- Tillstånd (State) ---
        let state = {
            fileName: 'Monteringsfäste_Demo.stl',
            material: 'PLA',
            colorHex: '#FF5500',
            colorName: 'Signalorange',
            infillPercent: 20,
            layerMultiplier: 1.0,
            layerLabel: '0.20 mm (Standard)',
            quantity: 1,
            unitScale: 1.0,
            rawVolumeMm3: 0,
            rawAreaMm2: 0,
            dimsMm: { x: 0, y: 0, z: 0 },
            exceedsCube: false,
            wireframe: false
        };

        // --- DOM-referenser ---
        const fileInput = document.getElementById('stl-upload');
        const dropzone = document.getElementById('dropzone');
        const activeFilenameEl = document.getElementById('active-filename');
        const errorMsgEl = document.getElementById('error-msg');
        const sizeWarningEl = document.getElementById('size-warning');
        const cubeStatusBadge = document.getElementById('cube-status-badge');
        const previewDimsPill = document.getElementById('preview-dims-pill');

        const statDims = document.getElementById('stat-dims');
        const statVol = document.getElementById('stat-vol');
        const statArea = document.getElementById('stat-area');
        const statWeight = document.getElementById('stat-weight');

        const infillSlider = document.getElementById('infill-slider');
        const infillLabel = document.getElementById('infill-label');
        const layerSelect = document.getElementById('layer-select');
        const qtyInput = document.getElementById('qty-input');
        const unitSelect = document.getElementById('unit-select');

        const quoteBase = document.getElementById('quote-base');
        const quoteQtyLabel = document.getElementById('quote-qty-label');
        const quoteMaterial = document.getElementById('quote-material');
        const quoteExVat = document.getElementById('quote-ex-vat');
        const quoteVat = document.getElementById('quote-vat');
        const quoteTotal = document.getElementById('quote-total');
        const quotePerUnit = document.getElementById('quote-per-unit');
        const discountBadge = document.getElementById('discount-badge');
        const openOrderModalBtn = document.getElementById('open-order-modal-btn');

        // --- Three.js variabler ---
        const container = document.getElementById('canvas-container');
        let scene, camera, renderer, controls;
        let currentMesh = null;
        let buildCubeLines = null;
        let buildCubeFill = null;

        // Initiera Three.js med 250 x 250 x 250 mm kub centrerad i origo (0,0,0)
        function initThreeScene() {
            scene = new THREE.Scene();
            scene.background = new THREE.Color('#E8E5DC');

            const aspect = container.clientWidth / container.clientHeight;
            camera = new THREE.PerspectiveCamera(42, aspect, 1, 5000);
            camera.position.set(340, 260, 380);

            renderer = new THREE.WebGLRenderer({ antialias: true });
            renderer.setSize(container.clientWidth, container.clientHeight);
            renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
            container.appendChild(renderer.domElement);

            controls = new THREE.OrbitControls(camera, renderer.domElement);
            controls.enableDamping = true;
            controls.dampingFactor = 0.06;
            controls.target.set(0, 0, 0);

            // Ljus
            const ambientLight = new THREE.AmbientLight(0xffffff, 0.65);
            scene.add(ambientLight);

            const dirLight1 = new THREE.DirectionalLight(0xffffff, 0.85);
            dirLight1.position.set(300, 500, 400);
            scene.add(dirLight1);

            const dirLight2 = new THREE.DirectionalLight(0xffffff, 0.35);
            dirLight2.position.set(-300, -200, -300);
            scene.add(dirLight2);

            // --- SKAPA 250 x 250 x 250 MM BYGGVOLYM-KUB CENTRERAD I ORIGO (0, 0, 0) ---
            const cubeGeo = new THREE.BoxGeometry(BUILD_VOLUME_MM, BUILD_VOLUME_MM, BUILD_VOLUME_MM);
            const edgesGeo = new THREE.EdgesGeometry(cubeGeo);
            const lineMat = new THREE.LineBasicMaterial({ color: 0x111111, linewidth: 2 });
            buildCubeLines = new THREE.LineSegments(edgesGeo, lineMat);
            buildCubeLines.position.set(0, 0, 0);
            scene.add(buildCubeLines);

            // Diskret halvtransparent fyllning i kuben för rumskänsla
            const cubeFillMat = new THREE.MeshBasicMaterial({
                color: 0xffffff,
                transparent: true,
                opacity: 0.08,
                depthWrite: false,
                side: THREE.BackSide
            });
            buildCubeFill = new THREE.Mesh(cubeGeo, cubeFillMat);
            buildCubeFill.position.set(0, 0, 0);
            scene.add(buildCubeFill);

            // Rutnät (Grid) i botten av 250 mm-kuben (vid y = -125 mm, 1 ruta = 10 mm)
            const bottomGrid = new THREE.GridHelper(BUILD_VOLUME_MM, 25, 0xFF5500, 0x99958C);
            bottomGrid.position.y = -BUILD_VOLUME_MM / 2;
            scene.add(bottomGrid);

            // Diskret mittkors i origo (0, 0, 0) som visar kubens exakta mittpunkt
            const centerCrossMat = new THREE.LineBasicMaterial({ color: 0xFF5500, transparent: true, opacity: 0.55 });
            const crossPoints = [
                new THREE.Vector3(-20, 0, 0), new THREE.Vector3(20, 0, 0),
                new THREE.Vector3(0, -20, 0), new THREE.Vector3(0, 20, 0),
                new THREE.Vector3(0, 0, -20), new THREE.Vector3(0, 0, 20)
            ];
            const crossGeo = new THREE.BufferGeometry().setFromPoints(crossPoints);
            const centerCross = new THREE.LineSegments(crossGeo, centerCrossMat);
            scene.add(centerCross);

            // Animationsloop
            function animate() {
                requestAnimationFrame(animate);
                controls.update();
                renderer.render(scene, camera);
            }
            animate();

            window.addEventListener('resize', onWindowResize);

            // Ladda en demomodell direkt så att kuben visar en centrerad modell från start
            loadProceduralBracketDemo();
        }

        function onWindowResize() {
            if (!container || !renderer) return;
            camera.aspect = container.clientWidth / container.clientHeight;
            camera.updateProjectionMatrix();
            renderer.setSize(container.clientWidth, container.clientHeight);
        }

        // --- Matematisk beräkning av exakt volym (mm³) och ytarea (mm²) ---
        function computeMeshMetrics(geometry) {
            const pos = geometry.attributes.position;
            if (!pos) return { volumeMm3: 0, areaMm2: 0 };

            const faceCount = pos.count / 3;
            let signedVolume = 0;
            let totalArea = 0;

            const p1 = new THREE.Vector3();
            const p2 = new THREE.Vector3();
            const p3 = new THREE.Vector3();
            const edge1 = new THREE.Vector3();
            const edge2 = new THREE.Vector3();
            const crossVec = new THREE.Vector3();

            for (let i = 0; i < faceCount; i++) {
                p1.fromBufferAttribute(pos, i * 3 + 0);
                p2.fromBufferAttribute(pos, i * 3 + 1);
                p3.fromBufferAttribute(pos, i * 3 + 2);

                // Ytarea av triangel: 0.5 * |(p2 - p1) x (p3 - p1)|
                edge1.subVectors(p2, p1);
                edge2.subVectors(p3, p1);
                crossVec.crossVectors(edge1, edge2);
                totalArea += 0.5 * crossVec.length();

                // Signerad volym av tetraeder från origo: (p1 . (p2 x p3)) / 6
                crossVec.crossVectors(p2, p3);
                signedVolume += p1.dot(crossVec) / 6.0;
            }

            return {
                volumeMm3: Math.abs(signedVolume),
                areaMm2: totalArea
            };
        }

        // --- Placera en BufferGeometry exakt i mitten (0,0,0) av 250 mm-kuben ---
        function setModelGeometry(geometry, fileNameLabel) {
            errorMsgEl.classList.add('hidden');

            // Säkerställ normaler och centrera geometrin i origo (0, 0, 0) - mitten av 250mm-kuben!
            geometry.computeVertexNormals();
            geometry.center();

            if (currentMesh) {
                scene.remove(currentMesh);
                currentMesh.geometry.dispose();
                currentMesh.material.dispose();
            }

            const material = new THREE.MeshStandardMaterial({
                color: new THREE.Color(state.colorHex),
                roughness: 0.38,
                metalness: 0.08,
                flatShading: true,
                wireframe: state.wireframe
            });

            currentMesh = new THREE.Mesh(geometry, material);
            // Placera exakt i mitten av 250 x 250 x 250 mm kuben
            currentMesh.position.set(0, 0, 0);
            scene.add(currentMesh);

            state.fileName = fileNameLabel;
            activeFilenameEl.textContent = `Aktiv modell: ${fileNameLabel} • Centrerad i 250 mm-kuben`;

            // Beräkna råvolym och råarea
            const metrics = computeMeshMetrics(geometry);
            state.rawVolumeMm3 = metrics.volumeMm3;
            state.rawAreaMm2 = metrics.areaMm2;

            updateDimensionsAndPrice();
        }

        // --- Uppdatera dimensioner, kontrollera 250mm-gränsen och beräkna pris ---
        function updateDimensionsAndPrice() {
            if (!currentMesh) return;

            const scale = state.unitScale;
            currentMesh.scale.set(scale, scale, scale);

            // Återcentrera efter ev. rotation/skalning så modellen alltid ligger i mitten (0,0,0)
            currentMesh.geometry.computeBoundingBox();
            const bbox = currentMesh.geometry.boundingBox;

            const sizeX = (bbox.max.x - bbox.min.x) * scale;
            const sizeY = (bbox.max.y - bbox.min.y) * scale;
            const sizeZ = (bbox.max.z - bbox.min.z) * scale;

            state.dimsMm = { x: sizeX, y: sizeY, z: sizeZ };

            // Kontrollera om modellen får plats i 250 x 250 x 250 mm kuben
            const exceeds = sizeX > BUILD_VOLUME_MM || sizeY > BUILD_VOLUME_MM || sizeZ > BUILD_VOLUME_MM;
            state.exceedsCube = exceeds;

            if (exceeds) {
                buildCubeLines.material.color.setHex(0xDC2626);
                sizeWarningEl.classList.remove('hidden');
                cubeStatusBadge.textContent = 'VARNING: ÖVERSKRIDER 250 MM!';
                cubeStatusBadge.className = 'bg-red-600 text-white font-mono text-xs font-bold px-2 py-0.5 uppercase';
            } else {
                buildCubeLines.material.color.setHex(0x111111);
                sizeWarningEl.classList.add('hidden');
                cubeStatusBadge.textContent = 'Kub: 250 × 250 × 250 mm (OK)';
                cubeStatusBadge.className = 'bg-uni-orange text-uni-black font-mono text-xs font-bold px-2 py-0.5 uppercase';
            }

            // Skalad volym (cm³) och ytarea (cm²)
            const volumeCm3 = (state.rawVolumeMm3 * Math.pow(scale, 3)) / 1000.0;
            const areaCm2 = (state.rawAreaMm2 * Math.pow(scale, 2)) / 100.0;

            // Viktberäkning: Skal (ytarea * 0.12 cm väggtjocklek) + inre volym * infill%
            const matInfo = MATERIALS[state.material];
            const shellVolumeCm3 = Math.min(volumeCm3, areaCm2 * 0.12);
            const interiorVolumeCm3 = Math.max(0, volumeCm3 - shellVolumeCm3);
            const effectivePlasticCm3 = shellVolumeCm3 + interiorVolumeCm3 * (state.infillPercent / 100.0);
            const weightGrams = Math.max(1, effectivePlasticCm3 * matInfo.density);

            // Prisformel:
            // Tar hänsyn till effektiv volym, ytarea (supports/komplexitet), materialpris, lagerhöjd och antal
            const infillFactor = 0.65 + (state.infillPercent / 100.0) * 0.75;
            const surfaceComplexityCost = areaCm2 * 0.08;
            const singlePartPrintCost = ((volumeCm3 * matInfo.pricePerCm3 * infillFactor) + surfaceComplexityCost) * state.layerMultiplier;

            // Mängdrabatt vid fler än 5 resp. 10 st
            let qtyDiscount = 1.0;
            if (state.quantity >= 10) {
                qtyDiscount = 0.85; // 15% rabatt
                discountBadge.textContent = '-15% Mängdrabatt';
                discountBadge.classList.remove('hidden');
            } else if (state.quantity >= 5) {
                qtyDiscount = 0.92; // 8% rabatt
                discountBadge.textContent = '-8% Mängdrabatt';
                discountBadge.classList.remove('hidden');
            } else {
                discountBadge.classList.add('hidden');
            }

            const totalMaterialAndMachine = singlePartPrintCost * state.quantity * qtyDiscount;
            const totalInclVat = Math.max(50, BASE_START_FEE + totalMaterialAndMachine);
            const totalExclVat = totalInclVat / 1.25;
            const vatAmount = totalInclVat - totalExclVat;
            const perUnitInclVat = totalInclVat / state.quantity;

            // Uppdatera UI-texter på svenska
            const dimsFormatted = `${sizeX.toFixed(1)} × ${sizeZ.toFixed(1)} × ${sizeY.toFixed(1)}`;
            statDims.textContent = dimsFormatted;
            previewDimsPill.textContent = `Modell: ${dimsFormatted} mm (i mitten)`;
            statVol.textContent = `${volumeCm3.toFixed(2)} cm³`;
            statArea.textContent = `${areaCm2.toFixed(1)} cm²`;
            statWeight.textContent = `${ Math.round(weightGrams)} g`;

            quoteBase.textContent = formatSEK(BASE_START_FEE);
            quoteQtyLabel.textContent = `${state.quantity} st`;
            quoteMaterial.textContent = formatSEK(totalInclVat - BASE_START_FEE);
            quoteExVat.textContent = formatSEK(totalExclVat);
            quoteVat.textContent = formatSEK(vatAmount);
            quoteTotal.textContent = `${Math.round(totalInclVat)} kr`;
            quotePerUnit.textContent = `${formatSEK(perUnitInclVat)} / st`;
        }

        function formatSEK(amount) {
            return amount.toLocaleString('sv-SE', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' kr';
        }

        // --- Demomodeller (så man direkt ser en modell centrerad i 250mm-kuben) ---
        function loadProceduralBracketDemo() {
            // Skapa ett mekaniskt L-fäste / monteringsfäste (ca 85 x 60 x 55 mm)
            const shape = new THREE.Shape();
            shape.moveTo(0, 0);
            shape.lineTo(85, 0);
            shape.lineTo(85, 14);
            shape.lineTo(18, 14);
            shape.lineTo(18, 60);
            shape.lineTo(0, 60);
            shape.closePath();

            const extrudeSettings = {
                steps: 1,
                depth: 50,
                bevelEnabled: true,
                bevelThickness: 2,
                bevelSize: 2,
                bevelSegments: 2
            };

            const geo = new THREE.ExtrudeGeometry(shape, extrudeSettings);
            const nonIndexedGeo = geo.toNonIndexed();
            setModelGeometry(nonIndexedGeo, 'Monteringsfäste_Demo.stl');
            focusCameraOnCube();
        }

        function loadProceduralTestCubeDemo() {
            const geo = new THREE.BoxGeometry(60, 60, 60).toNonIndexed();
            setModelGeometry(geo, 'Kalibreringskub_60mm.stl');
            focusCameraOnCube();
        }

        // --- Kameravyer ---
        function focusCameraOnCube() {
            controls.target.set(0, 0, 0);
            camera.position.set(340, 250, 370);
            controls.update();
        }

        function focusCameraOnModel() {
            if (!currentMesh) return;
            currentMesh.geometry.computeBoundingSphere();
            const radius = Math.max(30, currentMesh.geometry.boundingSphere.radius * state.unitScale);
            controls.target.set(0, 0, 0);
            camera.position.set(radius * 1.9, radius * 1.4, radius * 2.2);
            controls.update();
        }

        // --- Filuppladdning (STL) ---
        function processUploadedFile(file) {
            if (!file) return;
            const reader = new FileReader();
            reader.onload = function(event) {
                try {
                    const loader = new THREE.STLLoader();
                    let geometry = loader.parse(event.target.result);
                    if (geometry.index) {
                        geometry = geometry.toNonIndexed();
                    }
                    // Rotera från CAD Z-upp till Three.js Y-upp och centrera i 250mm-kuben
                    geometry.rotateX(-Math.PI / 2);
                    setModelGeometry(geometry, file.name);
                } catch (err) {
                    console.error(err);
                    errorMsgEl.classList.remove('hidden');
                }
            };
            reader.readAsArrayBuffer(file);
        }

        fileInput.addEventListener('change', (e) => {
            if (e.target.files && e.target.files[0]) {
                processUploadedFile(e.target.files[0]);
            }
        });

        // Drag & Drop på dropzone
        ['dragenter', 'dragover'].forEach(evtName => {
            dropzone.addEventListener(evtName, (e) => {
                e.preventDefault();
                e.stopPropagation();
                dropzone.classList.add('bg-orange-100');
            });
        });
        ['dragleave', 'drop'].forEach(evtName => {
            dropzone.addEventListener(evtName, (e) => {
                e.preventDefault();
                e.stopPropagation();
                dropzone.classList.remove('bg-orange-100');
            });
        });
        dropzone.addEventListener('drop', (e) => {
            const dt = e.dataTransfer;
            if (dt && dt.files && dt.files[0]) {
                processUploadedFile(dt.files[0]);
            }
        });

        // --- Rotationsknappar (roterar geometrin runt sin mittpunkt i 250mm-kuben) ---
        document.getElementById('rot-x-btn').addEventListener('click', () => {
            if (!currentMesh) return;
            currentMesh.geometry.rotateX(Math.PI / 2);
            currentMesh.geometry.center();
            updateDimensionsAndPrice();
        });
        document.getElementById('rot-y-btn').addEventListener('click', () => {
            if (!currentMesh) return;
            currentMesh.geometry.rotateY(Math.PI / 2);
            currentMesh.geometry.center();
            updateDimensionsAndPrice();
        });
        document.getElementById('rot-z-btn').addEventListener('click', () => {
            if (!currentMesh) return;
            currentMesh.geometry.rotateZ(Math.PI / 2);
            currentMesh.geometry.center();
            updateDimensionsAndPrice();
        });

        // --- Vy-knappar i 3D-fönstret ---
        document.getElementById('view-cube-btn').addEventListener('click', focusCameraOnCube);
        document.getElementById('view-model-btn').addEventListener('click', focusCameraOnModel);
        document.getElementById('toggle-wireframe-btn').addEventListener('click', (e) => {
            state.wireframe = !state.wireframe;
            if (currentMesh) {
                currentMesh.material.wireframe = state.wireframe;
            }
            e.currentTarget.classList.toggle('bg-uni-orange', state.wireframe);
            e.currentTarget.classList.toggle('bg-white', !state.wireframe);
        });

        // Demoknappar
        document.getElementById('load-bracket-btn').addEventListener('click', loadProceduralBracketDemo);
        document.getElementById('header-demo-btn').addEventListener('click', loadProceduralBracketDemo);
        document.getElementById('load-gear-btn').addEventListener('click', loadProceduralTestCubeDemo);

        // --- Materialknappar ---
        document.querySelectorAll('.mat-btn').forEach(btn => {
            btn.addEventListener('click', () => {
                state.material = btn.getAttribute('data-mat');
                document.querySelectorAll('.mat-btn').forEach(b => {
                    b.classList.remove('bg-uni-orange');
                    b.classList.add('bg-uni-bg');
                });
                btn.classList.remove('bg-uni-bg');
                btn.classList.add('bg-uni-orange');
                updateDimensionsAndPrice();
            });
        });

        // --- Färgknappar ---
        document.querySelectorAll('.color-btn').forEach(btn => {
            btn.addEventListener('click', () => {
                state.colorHex = btn.getAttribute('data-color');
                state.colorName = btn.getAttribute('data-name');
                document.getElementById('selected-color-name').textContent = state.colorName;

                document.querySelectorAll('.color-btn').forEach(b => {
                    b.classList.remove('ring-2', 'ring-offset-2', 'ring-uni-black');
                });
                btn.classList.add('ring-2', 'ring-offset-2', 'ring-uni-black');

                if (currentMesh) {
                    currentMesh.material.color.set(state.colorHex);
                }
            });
        });

        // --- Infill, Lagerhöjd, Enhet & Antal ---
        infillSlider.addEventListener('input', (e) => {
            state.infillPercent = parseInt(e.target.value, 10);
            let desc = 'Standard';
            if (state.infillPercent <= 15) desc = 'Lättvikt';
            else if (state.infillPercent >= 80) desc = 'Solid/Massiv';
            else if (state.infillPercent >= 40) desc = 'Förstärkt';
            infillLabel.textContent = `${state.infillPercent}% (${desc})`;
            updateDimensionsAndPrice();
        });

        layerSelect.addEventListener('change', (e) => {
            state.layerMultiplier = parseFloat(e.target.value);
            state.layerLabel = e.target.options[e.target.selectedIndex].text;
            updateDimensionsAndPrice();
        });

        unitSelect.addEventListener('change', (e) => {
            state.unitScale = parseFloat(e.target.value);
            updateDimensionsAndPrice();
        });

        document.getElementById('qty-minus').addEventListener('click', () => {
            state.quantity = Math.max(1, state.quantity - 1);
            qtyInput.value = state.quantity;
            updateDimensionsAndPrice();
        });
        document.getElementById('qty-plus').addEventListener('click', () => {
            state.quantity = Math.min(500, state.quantity + 1);
            qtyInput.value = state.quantity;
            updateDimensionsAndPrice();
        });
        qtyInput.addEventListener('input', (e) => {
            const val = parseInt(e.target.value, 10);
            state.quantity = isNaN(val) || val < 1 ? 1 : Math.min(500, val);
            updateDimensionsAndPrice();
        });

        // --- Beställningsmodal ---
        const orderModal = document.getElementById('order-modal');
        const orderSummaryBox = document.getElementById('order-summary-box');
        const mailtoOrderLink = document.getElementById('mailto-order-link');
        const copyFeedback = document.getElementById('copy-feedback');

        openOrderModalBtn.addEventListener('click', () => {
            const summaryText = [
                `BESTÄLLNING — UNiPRiNT3D (Ide till Verklighet)`,
                `--------------------------------------------`,
                `Filnamn:      ${state.fileName}`,
                `Dimensioner:  ${statDims.textContent} mm`,
                `Volym / Yta:  ${statVol.textContent} / ${statArea.textContent}`,
                `Beräknad vikt:${statWeight.textContent} per st`,
                `Material:     ${MATERIALS[state.material].name}`,
                `Färg:         ${state.colorName}`,
                `Fyllnadsgrad: ${state.infillPercent}%`,
                `Lagerhöjd:    ${state.layerLabel}`,
                `Antal:        ${state.quantity} st`,
                `--------------------------------------------`,
                `TOTALPRIS:    ${quoteTotal.textContent} (inkl. 25% moms)`
            ].join('\n');

            orderSummaryBox.textContent = summaryText;

            const subject = encodeURIComponent(`Beställning UNiPRiNT3D: ${state.fileName} (${state.quantity} st)`);
            const body = encodeURIComponent(
                `Hej UNiPRiNT3D!\n\nJag vill beställa följande 3D-utskrift:\n\n${summaryText}\n\n(Jag bifogar STL-filen i detta mejl)\n\nMitt namn:\nTelefonnummer (för Swish/leverans):`
            );
            mailtoOrderLink.href = `mailto:order@uniprint3d.se?subject=${subject}&body=${body}`;

            copyFeedback.classList.add('hidden');
            orderModal.classList.remove('hidden');
            orderModal.classList.add('flex');
        });

        document.getElementById('close-modal-btn').addEventListener('click', () => {
            orderModal.classList.add('hidden');
            orderModal.classList.remove('flex');
        });

        orderModal.addEventListener('click', (e) => {
            if (e.target === orderModal) {
                orderModal.classList.add('hidden');
                orderModal.classList.remove('flex');
            }
        });

        document.getElementById('copy-order-btn').addEventListener('click', () => {
            const textArea = document.createElement('textarea');
            textArea.value = orderSummaryBox.textContent;
            document.body.appendChild(textArea);
            textArea.select();
            document.execCommand('copy');
            document.body.removeChild(textArea);
            copyFeedback.classList.remove('hidden');
        });

        // Starta 3D-vyn vid laddning
        window.addEventListener('DOMContentLoaded', initThreeScene);
    </script>
</body>
</html>
