<!DOCTYPE html>
<html lang="sv">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>UNiPRiNT3D — Ide till Verklighet | Direktpris på 3D-utskrifter</title>
    
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    
    <!-- Google Fonts: Inter & Space Mono -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700;800;900&family=Space+Mono:wght@400;700&display=swap" rel="stylesheet">

    <!-- Three.js + OrbitControls + STLLoader -->
    <script src="https://cdn.jsdelivr.net/npm/three@0.128.0/build/three.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/three@0.128.0/examples/js/controls/OrbitControls.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/three@0.128.0/examples/js/loaders/STLLoader.js"></script>

    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['Inter', 'Arial Black', 'sans-serif'],
                        mono: ['Space Mono', 'monospace'],
                    },
                    colors: {
                        'uni-bg': '#F7F5F0',
                        'uni-orange': '#FF5500',
                        'uni-black': '#111111',
                        'uni-cream': '#EFECE4'
                    },
                    boxShadow: {
                        'brutal': '6px 6px 0px 0px #111111',
                        'brutal-lg': '8px 8px 0px 0px #111111',
                        'brutal-sm': '4px 4px 0px 0px #111111',
                        'brutal-xs': '2px 2px 0px 0px #111111',
                    }
                }
            }
        }
    </script>

    <style>
        body {
            background-color: #F7F5F0;
            color: #111111;
        }

        /* Neo-brutalistiska knappar */
        .btn-brutal {
            transition: transform 0.1s ease, box-shadow 0.1s ease, background-color 0.15s ease;
        }
        .btn-brutal:hover:not(:disabled) {
            transform: translate(-1px, -1px);
            box-shadow: 7px 7px 0px 0px #111111;
        }
        .btn-brutal:active:not(:disabled) {
            transform: translate(4px, 4px);
            box-shadow: 2px 2px 0px 0px #111111 !important;
        }

        .btn-brutal-sm {
            transition: transform 0.1s ease, box-shadow 0.1s ease;
        }
        .btn-brutal-sm:active:not(:disabled) {
            transform: translate(2px, 2px);
            box-shadow: 1px 1px 0px 0px #111111 !important;
        }

        /* =========================================================
           UNiPRiNT3D LOGOTYP - EXAKT TVÅNIVÅ-TYPOGRAFI
           Stora tecken (100% höjd): U, P, 3, D
           Lägre versaler (72% höjd på samma baslinje): N, R, N, T
           Speciella 'i': stapel exakt 72% höjd + prick i nivå med 100%
           ========================================================= */
        .uniprint-logo {
            display: inline-flex;
            align-items: baseline;
            font-family: 'Inter', 'Arial Black', sans-serif;
            font-weight: 900;
            letter-spacing: -0.055em;
            line-height: 0.82;
            user-select: none;
            position: relative;
        }
        .uniprint-logo .char-tall {
            font-size: 1em;
            display: inline-block;
            line-height: 0.82;
        }
        .uniprint-logo .char-short {
            font-size: 0.72em;
            display: inline-block;
            line-height: 0.82;
            transform: scaleX(1.06);
            transform-origin: bottom center;
            margin: 0 0.005em;
        }
        /* Konstruerat 'i' där stapeln har exakt samma höjd som N, R, N, T (72%)
           och pricken ligger ovanför och linjerar med toppen av U, P, 3, D */
        .uniprint-logo .char-i-wrap {
            display: inline-flex;
            flex-direction: column;
            align-items: center;
            justify-content: flex-end;
            height: 0.735em;
            width: 0.24em;
            margin: 0 0.015em;
            position: relative;
            vertical-align: baseline;
        }
        .uniprint-logo .char-i-dot {
            width: 0.165em;
            height: 0.145em;
            background-color: currentColor;
            position: absolute;
            top: 0.01em;
            left: 50%;
            transform: translateX(-50%);
        }
        .uniprint-logo .char-i-stem {
            width: 0.165em;
            height: 0.525em;
            background-color: currentColor;
            position: absolute;
            bottom: 0;
            left: 50%;
            transform: translateX(-50%);
        }

        /* Anpassad range-slider i brutalistisk stil */
        input[type="range"] {
            -webkit-appearance: none;
            appearance: none;
            width: 100%;
            height: 14px;
            background: #EFECE4;
            border: 3px solid #111111;
            outline: none;
        }
        input[type="range"]::-webkit-slider-thumb {
            -webkit-appearance: none;
            appearance: none;
            width: 26px;
            height: 26px;
            background: #FF5500;
            border: 3px solid #111111;
            cursor: pointer;
            box-shadow: 2px 2px 0px #111111;
        }
        input[type="range"]::-moz-range-thumb {
            width: 26px;
            height: 26px;
            background: #FF5500;
            border: 3px solid #111111;
            cursor: pointer;
            box-shadow: 2px 2px 0px #111111;
        }

        #canvas-container canvas {
            display: block;
            width: 100% !important;
            height: 100% !important;
            outline: none;
        }
    </style>
</head>
<body class="min-h-screen flex flex-col font-sans selection:bg-uni-orange selection:text-white">

    <!-- Toppbanner -->
    <div class="bg-uni-black text-uni-bg border-b-4 border-uni-black py-2 px-4 text-xs md:text-sm font-mono font-bold tracking-wider uppercase flex flex-wrap justify-between items-center gap-2">
        <div class="flex items-center gap-2">
            <span class="inline-block w-2.5 h-2.5 bg-uni-orange"></span>
            <span>SNABB TILLVERKNING I SVERIGE • BYGGVOLYM 250 × 250 × 250 MM</span>
        </div>
        <div class="hidden sm:flex items-center gap-4">
            <span>PLA • PETG • ASA • PC</span>
            <span class="text-uni-orange">DIREKTPRIS I WEBBLÄSAREN</span>
        </div>
    </div>

    <!-- Header med ny UNiPRiNT3D-logotyp och slogan -->
    <header class="border-b-4 border-uni-black bg-uni-bg sticky top-0 z-30">
        <div class="max-w-7xl mx-auto px-4 md:px-8 py-4 md:py-5 flex flex-wrap justify-between items-center gap-4">
            
            <!-- Logotyp + Slogan -->
            <a href="#" class="group flex flex-col items-start focus:outline-none">
                <div class="uniprint-logo text-4xl sm:text-5xl md:text-6xl text-uni-black" aria-label="UNiPRiNT3D">
                    <span class="char-tall">U</span><span class="char-short">N</span><span class="char-i-wrap" aria-hidden="true"><span class="char-i-dot"></span><span class="char-i-stem"></span></span><span class="sr-only">i</span><span class="char-tall">P</span><span class="char-short">R</span><span class="char-i-wrap" aria-hidden="true"><span class="char-i-dot"></span><span class="char-i-stem"></span></span><span class="sr-only">i</span><span class="char-short">N</span><span class="char-short">T</span><span class="char-tall text-uni-orange">3</span><span class="char-tall">D</span>
                </div>
                <div class="flex items-center gap-2 mt-1.5">
                    <span class="bg-uni-orange border-2 border-uni-black px-2 py-0.5 text-xs md:text-sm font-black uppercase tracking-widest text-uni-black shadow-brutal-xs">
                        Ide till Verklighet
                    </span>
                    <span class="text-xs font-mono font-bold uppercase text-neutral-600 hidden sm:inline">
                        // 3D-utskrifter på beställning
                    </span>
                </div>
            </a>

            <!-- Snabbknappar i headern -->
            <div class="flex items-center gap-3">
                <button id="header-demo-btn" type="button" class="btn-brutal-sm bg-white border-3 border-uni-black px-3.5 py-2 text-xs md:text-sm font-black uppercase shadow-brutal-sm hover:bg-uni-cream">
                    Testa med demofil
                </button>
                <a href="#kalkylator" class="btn-brutal-sm bg-uni-orange border-3 border-uni-black px-4 py-2 text-xs md:text-sm font-black uppercase text-uni-black shadow-brutal-sm">
                    Ladda upp STL &rarr;
                </a>
            </div>
        </div>
    </header>

    <!-- Hero-sektion -->
    <section class="max-w-7xl mx-auto w-full px-4 md:px-8 pt-8 pb-6">
        <div class="bg-white border-4 border-uni-black p-6 md:p-8 shadow-brutal flex flex-col lg:flex-row justify-between items-start lg:items-center gap-6">
            <div class="max-w-2xl">
                <div class="inline-block bg-uni-black text-white font-mono text-xs font-bold uppercase px-3 py-1 mb-3">
                    UNiPRiNT3D • IDE TILL VERKLIGHET
                </div>
                <h1 class="text-3xl sm:text-5xl font-black tracking-tight text-uni-black leading-none uppercase">
                    Från CAD-fil till färdig del. <span class="text-uni-orange underline decoration-4 underline-offset-4">Direktpris.</span>
                </h1>
                <p class="mt-3 text-base md:text-lg font-medium text-neutral-700">
                    Ladda upp din <span class="font-mono font-bold text-uni-black">.STL</span>-fil för att direkt beräkna volym, ytarea, vikt och pris. Modellen placeras automatiskt i mitten av vår <span class="font-bold text-uni-black">250 × 250 × 250 mm</span> byggvolym.
                </p>
            </div>

            <!-- 3 snabba steg -->
            <div class="grid grid-cols-3 gap-2 sm:gap-3 w-full lg:w-auto shrink-0">
                <div class="bg-uni-bg border-3 border-uni-black p-3 shadow-brutal-xs">
                    <span class="font-mono text-xs font-bold text-uni-orange block">STEG 01</span>
                    <span class="font-black text-sm md:text-base uppercase block mt-0.5">Ladda upp STL</span>
                </div>
                <div class="bg-uni-bg border-3 border-uni-black p-3 shadow-brutal-xs">
                    <span class="font-mono text-xs font-bold text-uni-orange block">STEG 02</span>
                    <span class="font-black text-sm md:text-base uppercase block mt-0.5">Välj material</span>
                </div>
                <div class="bg-uni-bg border-3 border-uni-black p-3 shadow-brutal-xs">
                    <span class="font-mono text-xs font-bold text-uni-orange block">STEG 03</span>
                    <span class="font-black text-sm md:text-base uppercase block mt-0.5">Beställ direkt</span>
                </div>
            </div>
        </div>
    </section>

    <!-- Huvudkalkylator -->
    <main id="kalkylator" class="max-w-7xl mx-auto w-full px-4 md:px-8 pb-16 flex-grow">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">

            <!-- VÄNSTER KOLUMN: 3D-Förhandsgranskning med 250 mm kub & Filuppladdning (7 kolumner) -->
            <div class="lg:col-span-7 flex flex-col gap-6">

                <!-- 1. Ladda upp STL-fil -->
                <div class="bg-white border-4 border-uni-black p-5 md:p-6 shadow-brutal">
                    <div class="flex flex-wrap justify-between items-center gap-2 mb-4">
                        <h2 class="text-xl md:text-2xl font-black uppercase flex items-center gap-2">
                            <span class="bg-uni-black text-white px-2.5 py-0.5 font-mono text-base">1</span>
                            Ladda upp 3D-modell (.STL)
                        </h2>
                        <div class="flex items-center gap-2">
                            <button type="button" id="load-bracket-btn" class="btn-brutal-sm bg-uni-bg border-2 border-uni-black px-3 py-1 text-xs font-black uppercase shadow-brutal-xs hover:bg-uni-orange hover:text-black">
                                Demodel: Fäste
                            </button>
                            <button type="button" id="load-gear-btn" class="btn-brutal-sm bg-uni-bg border-2 border-uni-black px-3 py-1 text-xs font-black uppercase shadow-brutal-xs hover:bg-uni-orange hover:text-black">
                                Demodel: Testkub 60mm
                            </button>
                        </div>
                    </div>

                    <!-- Dropzone -->
                    <label for="stl-upload" id="dropzone" class="block border-4 border-dashed border-uni-black bg-uni-bg hover:bg-orange-50 transition-colors p-5 md:p-6 cursor-pointer text-center">
                        <input type="file" id="stl-upload" accept=".stl" class="hidden">
                        <div class="flex flex-col items-center justify-center gap-2">
                            <div class="w-12 h-12 bg-uni-orange border-3 border-uni-black shadow-brutal-xs flex items-center justify-center font-black text-2xl">
                                &uarr;
                            </div>
                            <p class="font-black text-base md:text-lg uppercase mt-1">
                                Dra och släpp din STL-fil här, eller <span class="underline text-uni-orange">välj fil från datorn</span>
                            </p>
                            <p id="active-filename" class="font-mono text-xs md:text-sm font-bold text-neutral-600">
                                Aktiv modell: Demomodell (Monteringsfäste.stl) • Beräknas lokalt i din webbläsare
                            </p>
                        </div>
                    </label>

                    <!-- Felmeddelande vid ogiltig fil -->
                    <div id="error-msg" class="hidden mt-4 bg-red-100 border-4 border-uni-black p-4 font-bold text-red-900 shadow-brutal-xs">
                        Kunde inte läsa filen. Kontrollera att du har valt en giltig binär eller ASCII .STL-fil.
                    </div>

                    <!-- Varning om modellen överskrider 250x250x250 mm -->
                    <div id="size-warning" class="hidden mt-4 bg-red-600 text-white border-4 border-uni-black p-4 shadow-brutal-sm">
                        <div class="flex items-start gap-3">
                            <span class="font-mono font-black text-2xl leading-none">!</span>
                            <div>
                                <p class="font-black uppercase text-base">Modellen överskrider maxvolymen 250 × 250 × 250 mm!</p>
                                <p class="text-sm font-medium mt-0.5">
                                    En eller flera sidor är längre än 250 mm. Skala ned modellen i ditt CAD-program eller kontakta oss för uppdelad utskrift.
                                </p>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- 2. 3D-Preview med 250 x 250 x 250 mm kub -->
                <div class="bg-white border-4 border-uni-black shadow-brutal flex flex-col">
                    <!-- Topplist för 3D-vy -->
                    <div class="bg-uni-black text-white px-4 py-3 flex flex-wrap justify-between items-center gap-2 border-b-4 border-uni-black">
                        <div class="flex items-center gap-2.5">
                            <span class="inline-block w-3 h-3 bg-uni-orange border border-white"></span>
                            <span class="font-black uppercase tracking-wider text-sm md:text-base">3D-Förhandsgranskning</span>
                            <span id="cube-status-badge" class="bg-uni-orange text-uni-black font-mono text-xs font-bold px-2 py-0.5 uppercase">
                                Kub: 250 × 250 × 250 mm
                            </span>
                        </div>
                        <span class="font-mono text-xs text-neutral-300">
                            Centrerad i kubens mitt (0, 0, 0) • Dra för att rotera
                        </span>
                    </div>

                    <!-- Canvas-behållare -->
                    <div id="canvas-container" class="h-[360px] sm:h-[440px] bg-[#E8E5DC] relative cursor-grab active:cursor-grabbing overflow-hidden">
                        <!-- Info-etikett uppe till vänster i 3D-vyn -->
                        <div class="absolute top-3 left-3 z-10 pointer-events-none flex flex-col gap-1">
                            <div class="bg-white/95 border-2 border-uni-black px-2.5 py-1 shadow-brutal-xs font-mono text-xs font-bold">
                                Ytterkub: <span class="text-uni-orange">250 × 250 × 250 mm</span>
                            </div>
                            <div id="preview-dims-pill" class="bg-uni-black/90 text-white px-2.5 py-1 font-mono text-xs font-bold">
                                Modell: 0 × 0 × 0 mm (i mitten)
                            </div>
                        </div>

                        <!-- Vyer / Kameraknappar uppe till höger i 3D-vyn -->
                        <div class="absolute top-3 right-3 z-10 flex flex-wrap gap-1.5 justify-end">
                            <button type="button" id="view-cube-btn" class="btn-brutal-sm bg-white border-2 border-uni-black px-2.5 py-1 font-mono text-xs font-bold uppercase shadow-brutal-xs hover:bg-uni-orange">
                                Visa 250mm-kub
                            </button>
                            <button type="button" id="view-model-btn" class="btn-brutal-sm bg-white border-2 border-uni-black px-2.5 py-1 font-mono text-xs font-bold uppercase shadow-brutal-xs hover:bg-uni-orange">
                                Zooma modell
                            </button>
                            <button type="button" id="toggle-wireframe-btn" class="btn-brutal-sm bg-white border-2 border-uni-black px-2.5 py-1 font-mono text-xs font-bold uppercase shadow-brutal-xs hover:bg-uni-orange">
                                Trådram
                            </button>
                        </div>
                    </div>

                    <!-- Verktygsfält under 3D-vyn: Rotera modellen (alltid i mitten av 250mm-kuben) -->
                    <div class="bg-uni-bg border-t-4 border-uni-black px-4 py-3 flex flex-wrap justify-between items-center gap-3">
                        <div class="flex items-center gap-1.5 flex-wrap">
                            <span class="font-mono text-xs font-bold uppercase mr-1">Rotera i kuben:</span>
                            <button type="button" id="rot-x-btn" class="btn-brutal-sm bg-white border-2 border-uni-black px-2.5 py-1 font-mono text-xs font-bold shadow-brutal-xs hover:bg-uni-orange">
                                X +90°
                            </button>
                            <button type="button" id="rot-y-btn" class="btn-brutal-sm bg-white border-2 border-uni-black px-2.5 py-1 font-mono text-xs font-bold shadow-brutal-xs hover:bg-uni-orange">
                                Y +90°
                            </button>
                            <button type="button" id="rot-z-btn" class="btn-brutal-sm bg-white border-2 border-uni-black px-2.5 py-1 font-mono text-xs font-bold shadow-brutal-xs hover:bg-uni-orange">
                                Z +90°
                            </button>
                        </div>
                        <div class="flex items-center gap-2">
                            <span class="font-mono text-xs font-bold uppercase">Enhet i STL:</span>
                            <select id="unit-select" class="bg-white border-2 border-uni-black px-2 py-1 font-mono text-xs font-bold shadow-brutal-xs cursor-pointer">
                                <option value="1" selected>Millimeter (mm)</option>
                                <option value="10">Centimeter (cm &rarr; mm)</option>
                                <option value="25.4">Tum (inch &rarr; mm)</option>
                            </select>
                        </div>
                    </div>
                </div>

                <!-- 3. Geometrisk analys (kort under 3D-vyn) -->
                <div class="grid grid-cols-2 sm:grid-cols-4 gap-4">
                    <div class="bg-white border-4 border-uni-black p-4 shadow-brutal-sm">
                        <span class="font-mono text-xs font-bold uppercase text-neutral-500 block">Dimensioner (mm)</span>
                        <span id="stat-dims" class="font-black text-base md:text-lg block mt-1">0 × 0 × 0</span>
                    </div>
                    <div class="bg-white border-4 border-uni-black p-4 shadow-brutal-sm">
                        <span class="font-mono text-xs font-bold uppercase text-neutral-500 block">Modellvolym</span>
                        <span id="stat-vol" class="font-black text-base md:text-lg block mt-1">0.00 cm³</span>
                    </div>
                    <div class="bg-white border-4 border-uni-black p-4 shadow-brutal-sm">
                        <span class="font-mono text-xs font-bold uppercase text-neutral-500 block">Ytarea</span>
                        <span id="stat-area" class="font-black text-base md:text-lg block mt-1">0.00 cm²</span>
                    </div>
                    <div class="bg-white border-4 border-uni-black p-4 shadow-brutal-sm">
                        <span class="font-mono text-xs font-bold uppercase text-neutral-500 block">Beräknad vikt</span>
                        <span id="stat-weight" class="font-black text-base md:text-lg text-uni-orange block mt-1">0 g</span>
                    </div>
                </div>

            </div>

            <!-- HÖGER KOLUMN: Utskriftsval & Prisberäkning (5 kolumner) -->
            <div class="lg:col-span-5 flex flex-col gap-6">

                <!-- Utskriftsparametrar -->
                <div class="bg-white border-4 border-uni-black p-5 md:p-6 shadow-brutal flex flex-col gap-5">
                    <h2 class="text-xl md:text-2xl font-black uppercase flex items-center gap-2">
                        <span class="bg-uni-black text-white px-2.5 py-0.5 font-mono text-base">2</span>
                        Välj material & utförande
                    </h2>

                    <!-- Materialval -->
                    <div>
                        <label class="font-black text-sm uppercase tracking-wider block mb-2">Material (Filament):</label>
                        <div class="grid grid-cols-2 gap-2.5" id="material-cards">
                            <button type="button" data-mat="PLA" class="mat-btn border-3 border-uni-black p-3 text-left bg-uni-orange shadow-brutal-xs transition-all">
                                <div class="flex justify-between items-center">
                                    <span class="font-black text-base">PLA</span>
                                    <span class="font-mono text-xs font-bold bg-uni-black text-white px-1.5 py-0.5">1.50 kr/cm³</span>
                                </div>
                                <p class="text-xs font-bold mt-1 text-uni-black/90">Standard, snygg yta &amp; prototyper</p>
                            </button>

                            <button type="button" data-mat="PETG" class="mat-btn border-3 border-uni-black p-3 text-left bg-uni-bg hover:bg-uni-cream shadow-brutal-xs transition-all">
                                <div class="flex justify-between items-center">
                                    <span class="font-black text-base">PETG</span>
                                    <span class="font-mono text-xs font-bold bg-uni-black text-white px-1.5 py-0.5">2.10 kr/cm³</span>
                                </div>
                                <p class="text-xs font-bold mt-1 text-neutral-700">Slagtåligt, mekaniska delar</p>
                            </button>

                            <button type="button" data-mat="ASA" class="mat-btn border-3 border-uni-black p-3 text-left bg-uni-bg hover:bg-uni-cream shadow-brutal-xs transition-all">
                                <div class="flex justify-between items-center">
                                    <span class="font-black text-base">ASA</span>
                                    <span class="font-mono text-xs font-bold bg-uni-black text-white px-1.5 py-0.5">2.60 kr/cm³</span>
                                </div>
                                <p class="text-xs font-bold mt-1 text-neutral-700">UV- &amp; väderbeständigt, utomhus</p>
                            </button>

                            <button type="button" data-mat="PC" class="mat-btn border-3 border-uni-black p-3 text-left bg-uni-bg hover:bg-uni-cream shadow-brutal-xs transition-all">
                                <div class="flex justify-between items-center">
                                    <span class="font-black text-base">PC</span>
                                    <span class="font-mono text-xs font-bold bg-uni-black text-white px-1.5 py-0.5">3.80 kr/cm³</span>
                                </div>
                                <p class="text-xs font-bold mt-1 text-neutral-700">Polykarbonat, extrem styrka</p>
                            </button>
                        </div>
                    </div>

                    <!-- Färgval -->
                    <div>
                        <div class="flex justify-between items-center mb-2">
                            <label class="font-black text-sm uppercase tracking-wider">Färg på utskrift:</label>
                            <span id="selected-color-name" class="font-mono text-xs font-bold uppercase text-uni-orange">Signalorange</span>
                        </div>
                        <div class="flex flex-wrap gap-2.5" id="color-swatches">
